---
import Base from '../layouts/Base.astro';
import Workspace from '../components/Workspace';
import { workspaceFor } from '../lib/workspace';
await workspaceFor(Astro.locals.user).spaces();
const user = Astro.locals.user;
---
<Base title="Calendar · Hung Workspace">
  <Workspace client:only="react" initialId={null} initialView="calendar" userName={user.name} userEmail={user.email} />
</Base>
