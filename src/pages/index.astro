---
import Base from '../layouts/Base.astro';
import Workspace from '../components/Workspace';
import { ensureWelcome } from '../lib/seed';
await ensureWelcome();
const user = Astro.locals.user;
---
<Base>
  <Workspace client:only="react" initialId={null} userName={user.name} userEmail={user.email} />
</Base>
