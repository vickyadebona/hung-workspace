---
import Base from '../../layouts/Base.astro';
import Workspace from '../../components/Workspace';
import { workspaceFor } from '../../lib/workspace';
// Create the person's Personal space (and the shared HQ space, once) before the page loads.
await workspaceFor(Astro.locals.user).spaces();
const { id } = Astro.params;
const user = Astro.locals.user;
---
<Base>
  <Workspace client:only="react" initialId={id ?? null} userName={user.name} userEmail={user.email} />
</Base>
